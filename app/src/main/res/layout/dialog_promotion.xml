<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/choose_promotion"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPromoQueen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:drawableStart="@drawable/ic_white_queen"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/piece_queen"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnPromoRook"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_white_rook"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/piece_rook"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnPromoBishop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_white_bishop"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/piece_bishop"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnPromoKnight"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_white_knight"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/piece_knight"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
</LinearLayout>